# Copy to backend/.env and fill in. Never commit .env.

# SQLite by default. For a hosted Postgres later (Supabase/Neon), e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./tracker.db

# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it here (spaces are fine to remove).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASSWORD=
# Gmail filters/labels can skip the inbox; use "[Gmail]/All Mail" to scan everything.
IMAP_FOLDER=INBOX

INITIAL_LOOKBACK_DAYS=90
GHOST_AFTER_DAYS=30
DUPLICATE_WINDOW_DAYS=60

# Sync in the background every N minutes while the server runs (0 = off: use "Sync now" or cron)
SYNC_EVERY_MINUTES=180

# Host names the server answers to. Add your domain if you host it somewhere (or "*" for any).
ALLOWED_HOSTS=localhost,127.0.0.1,::1
